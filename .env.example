# 이 파일을 `.env` 로 복사해서 쓴다. 없어도 돌아간다 — 기본값이 vite.config.ts 에 있다.

# 백엔드 주소. 개발 서버와 `vite preview` 가 `/api` 를 여기로 넘긴다.
# 배포에서는 vercel.json 의 rewrites 가 같은 일을 하므로 Vercel 에 넣지 않아도 된다.
VITE_BACKEND_BASE_URL=https://d3f36x6ccm838d.cloudfront.net

# 인증이 필요한 경로(/api/me/* 등)용 액세스 토큰. 데모 경로에는 필요 없다.
# **여기에 적은 값은 빌드 결과에 그대로 들어간다.** 공개해도 되는 값만 적는다.
VITE_BACKEND_ACCESS_TOKEN=
